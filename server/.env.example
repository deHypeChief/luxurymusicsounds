# ---------------------------------------------------------------------------
# Luxury Music Sounds API configuration
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Database --------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/luxurymusicsounds
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/luxurymusicsounds?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/luxurymusicsounds

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -hex 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=lms_admin
# Only set in production, e.g. .luxurymusicsounds.com (leading dot shares it across subdomains)
COOKIE_DOMAIN=

# --- Front end -------------------------------------------------------------
# Where Paystack sends the buyer back after checkout.
CLIENT_URL=http://localhost:5173
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# --- Paystack --------------------------------------------------------------
# Dashboard → Settings → API Keys & Webhooks. Use sk_test_/pk_test_ while building.
# Set the webhook URL there to: https://<your-api-domain>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CURRENCY=NGN

# --- Cloudflare Images -----------------------------------------------------
# Account ID:    Cloudflare dashboard sidebar
# Images token:  My Profile → API Tokens → Create Token → Cloudflare Images (Edit)
# Account hash:  Images → Developer Resources → the id inside your delivery URL
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=
CLOUDFLARE_ACCOUNT_HASH=
CLOUDFLARE_IMAGE_VARIANT=public

# --- First-run admin account ----------------------------------------------
# Used only by `bun run seed`. Change the password immediately after signing in.
SEED_ADMIN_EMAIL=admin@luxurymusicsounds.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=Israel Peter
